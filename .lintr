# lintr configuration for mufflyaccess.
#
# The `lint` job is ADVISORY until this baseline is clean; promote it to
# blocking (drop continue-on-error in ci.yml) once it passes. A check that is
# red from birth teaches people to ignore red.
linters: linters_with_defaults(
    line_length_linter(100),
    object_name_linter = NULL,      # SSOT constants are SCREAMING_SNAKE by design
    cyclocomp_linter = NULL,        # contract functions are branchy on purpose
    commented_code_linter = NULL    # documented provenance often quotes code
  )
exclusions: list(
    "tests/testthat",
    "man",
    "docs"
  )
